# Copy to ~/.config/hermes-tv/bridge.env (or point HERMESTV_ENV_FILE at your copy) and fill in the values.

# The TV's bearer token, also TV_KEY in tv/bridge.properties; empty rejects every /v1 request. Make one: openssl rand -hex 32
TV_KEY=

# The Hermes API server address, for example http://127.0.0.1:8642; leave it empty to run without Hermes.
HERMES_URL=
# The Hermes API server key; needed only when HERMES_URL is set.
HERMES_KEY=
# The Docker container that runs Hermes (default hermes): the schedule row reads its jobs there, and, when HERMES_TV_DIR is set, the chat feature shares files there.
HERMES_CONTAINER=hermes
# Comma-separated exact names of the Hermes jobs the TV may show; empty shows no schedule.
SCHEDULE_JOBS=
# The folder in the Hermes container shared with the hermes-tv skill (watch.json out, requests.json in), for example /opt/data/hermes-tv; empty turns it off.
HERMES_TV_DIR=
# A folder under /opt/data/ in the Hermes container for the daily Watch Log.md and Taste.md notes; empty turns them off.
HERMES_VAULT_TV_DIR=

# The TV's time zone (IANA name); it sets the time slots, the schedule day and the scenery (default UTC).
TIME_ZONE=UTC
# Your location for the weather; set both or neither (no weather).
LATITUDE=
LONGITUDE=

# Your TMDB API key or read access token, from https://www.themoviedb.org/settings/api; empty gives empty film and series rows.
TMDB_API_KEY=
# The country for TMDB streaming availability, ISO 3166-1 (default US).
REGION=US
# The original language of the local-titles rows, ISO 639-1 (default en).
LOCAL_LANGUAGE=en

# Comma-separated YouTube searches; empty turns YouTube off, and no line at all uses these defaults.
YOUTUBE_QUERIES=unsolved mysteries,true crime documentary
# Comma-separated words or phrases; a video whose title or channel holds one as a whole word is skipped.
YOUTUBE_EXCLUDE=cooking,recipe
